# Copy this to server/.env — never commit the real file.

# ── Provider ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=gemma2:2b

# ── Local Ollama ───────────────────────────────────────────────────────────────
# Install the model with: ollama pull gemma2:2b
OLLAMA_URL=http://localhost:11434
# OLLAMA_API_KEY is only needed when using Ollama Cloud.
# OLLAMA_API_KEY=your_ollama_api_key_here

# ── Shared ─────────────────────────────────────────────────────────────────────
PORT=3000
# Default local-model inference timeout is 120000ms.
# LLM_TIMEOUT_MS=120000
